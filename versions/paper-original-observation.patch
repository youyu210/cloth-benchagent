+// Paper comparison adapter. Fixed original scene 1, with legacy rendering
+// and report I/O outside the synchronized physical-step measurement.
+extern bool paper_benchmark;
+extern double paper_step_ms;
+extern int paper_newton_cap_hits;
+extern int totalNT;
+extern double total_Cg_count;
+extern double totalCollisionPairs;
+
+static int run_paper_benchmark(int frames, const std::filesystem::path& out)
+{
+    if(frames < 1 || frames > 1000 || std::filesystem::exists(out))
+        throw std::runtime_error("Invalid frames or nonempty output directory");
+    std::filesystem::create_directories(out);
+    paper_benchmark = true;
+    Init_CUDA();
+    LoadSettings();
+    ipc.build_gipc_system(d_tetMesh);
+    initScene();
+    CUDA_SAFE_CALL(cudaDeviceSynchronize());
+    std::vector<double3> vertices(ipc.vertexNum);
+    auto snapshot = [&](const char* name)
+    {
+        CUDA_SAFE_CALL(cudaMemcpy(vertices.data(), ipc._vertexes,
+                                  vertices.size() * sizeof(double3), cudaMemcpyDeviceToHost));
+        for(const auto& point : vertices)
+            if(!std::isfinite(point.x) || !std::isfinite(point.y) || !std::isfinite(point.z))
+                throw std::runtime_error("Nonfinite position");
+        if(!name)
+            return;
+        std::ofstream stream(out / name, std::ios::binary);
+        stream.write(reinterpret_cast<const char*>(vertices.data()),
+                     vertices.size() * sizeof(double3));
+        if(!stream)
+            throw std::runtime_error("Failed to write position snapshot");
+    };
+    snapshot("initial.f64");
+    auto save_device = [&](const char* name, auto* pointer, size_t size)
+    {
+        std::vector<char> data(size);
+        if(size)
+            CUDA_SAFE_CALL(cudaMemcpy(data.data(), pointer, size, cudaMemcpyDeviceToHost));
+        std::ofstream stream(out / name, std::ios::binary);
+        stream.write(data.data(), data.size());
+        if(!stream)
+            throw std::runtime_error("Failed to write initial-state evidence");
+    };
+    save_device("initial_velocities.f64", d_tetMesh.velocities, ipc.vertexNum * sizeof(double3));
+    save_device("masses.f64", d_tetMesh.masses, ipc.vertexNum * sizeof(double));
+    save_device("boundary.i32", d_tetMesh.BoundaryType, ipc.vertexNum * sizeof(int));
+    save_device("tetrahedra.u32", d_tetMesh.tetrahedras, tetMesh.tetrahedraNum * sizeof(uint4));
+    std::ofstream metadata(out / "metadata.json");
+    metadata << gipc::Json{{"scene_no", 1}, {"frames", frames},
+                           {"vertex_count", ipc.vertexNum}, {"tetrahedron_count", tetMesh.tetrahedraNum},
+                           {"dt", ipc.IPC_dt}, {"pcg_tolerance", ipc.pcg_threshold},
+                           {"newton_tolerance", ipc.Newton_solver_threshold},
+                           {"gpu_index", 0}, {"method", "original"},
+                           {"timing", "synchronized host wall clock inside IPC_Solver, before legacy I/O"}}.dump(2);
+    if(!metadata)
+        throw std::runtime_error("Failed to write metadata");
+    metadata.close();
+    std::ofstream csv(out / "frames.csv");
+    csv << "frame,step_ms,newton_iters,pcg_iters,collision_counter_cumulative,newton_cap_hits\n";
+    csv.precision(17);
+    for(int f = 1; f <= frames; ++f)
+    {
+        const int newton_before = totalNT;
+        const double pcg_before = total_Cg_count;
+        paper_newton_cap_hits = 0;
+        ipc.IPC_Solver(d_tetMesh);
+        snapshot(f == frames ? "final.f64" : nullptr);
+        csv << f << ',' << paper_step_ms << ',' << totalNT - newton_before << ','
+            << total_Cg_count - pcg_before << ',' << totalCollisionPairs << ',' << paper_newton_cap_hits << '\n';
+    }
+    csv.flush();
+    if(!csv)
+        throw std::runtime_error("Failed to write frame data");
+    std::ofstream(out / "status.json")
+        << gipc::Json{{"completed", true}, {"frames_completed", frames}, {"finite_state", true}}.dump(2);
+    std::cout << "TEST_COMPLETE frames=" << frames << std::endl;
+    return 0;
+}
+
 int main(int argc, char** argv)
 {
+    if(argc == 4 && std::string(argv[1]) == "--paper-benchmark")
+    {
+        try
+        {
+            return run_paper_benchmark(std::stoi(argv[2]), argv[3]);
+        }
+        catch(const std::exception& error)
+        {
+            std::cerr << error.what() << std::endl;
+            return 2;
+        }
+    }
     glutInit(&argc, argv);
