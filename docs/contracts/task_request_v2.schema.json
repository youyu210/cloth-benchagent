{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchAgent V4 task request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "mode",
    "scene",
    "backend_id",
    "task_frames",
    "timeout_sec"
  ],
  "properties": {
    "schema_version": {
      "const": "task-request-v2"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "mode": {
      "enum": [
        "standard",
        "custom"
      ]
    },
    "scene": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "backend_id": {
      "const": "c0-003-benchagent-v1"
    },
    "task_frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      }
    },
    "timeout_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "native_render": {
      "type": "boolean"
    },
    "diagnostic_contact_trace": {
      "type": "boolean"
    },
    "material": {
      "type": "object",
      "required": ["object", "values", "previous"],
      "additionalProperties": false,
      "properties": {
        "object": {"const": "cloth"},
        "values": {"$ref": "#/$defs/materialValues"},
        "previous": {"$ref": "#/$defs/materialValues"}
      }
    },
    "output_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "step_time",
          "newton_iterations",
          "pcg_iterations",
          "collision_pairs"
        ]
      }
    }
  },
  "$defs": {
    "materialValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "young_pa": {"type": "number"},
        "density_kg_m3": {"type": "number"},
        "poisson_ratio": {"type": "number"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "standard"
          }
        }
      },
      "then": {
        "properties": {
          "task_frames": {
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "enum": [
                20,
                50,
                100
              ]
            }
          }
        }
      }
    }
  ]
}
